# Copiá este archivo a .env y completá tu clave. El .env NO se sube al repo.
# La clave se saca gratis en https://aistudio.google.com/apikey
GOOGLE_API_KEY=...

# Modelos de Google AI Studio. Podés cambiarlos sin tocar código.
# Ojo: si cambiás el modelo de embeddings hay que reindexar los PDF.
MODELO_LLM=gemini-3.6-flash
MODELO_EMBEDDINGS=gemini-embedding-001
